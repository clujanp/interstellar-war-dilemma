{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Remote Attach",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "."
                }
            ],
            "justMyCode": false
        },
        {
            "name": "Python: Unittest",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/tests", // Ruta a tus pruebas
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}